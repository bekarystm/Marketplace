{
  "expo": {
    "name": "TDKFOOD",
    "slug": "tdkfood",
    "scheme": "tdkfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.tdkfood.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Чтобы определить адрес доставки и показать ближайшие магазины"
      }
    },
    "android": {
      "package": "kz.tdkfood.client",
      "adaptiveIcon": {
        "backgroundColor": "#1F4D2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы определить адрес доставки и показать ближайшие магазины"
        }
      ],
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "splash": {
      "backgroundColor": "#FBF7EF"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c492ec53-1b4f-4a92-a9b0-69a5dfb3a027"
      }
    },
    "owner": "bekarystm"
  }
}
