{
  "expo": {
    "name": "TDKFOOD Партнёр",
    "slug": "tdkfood-partner",
    "scheme": "tdkfood-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.tdkfood.partner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Чтобы показывать заказы рядом и передавать клиенту, где находится курьер",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Чтобы клиент видел курьера на карте, даже когда приложение свёрнуто",
        "NSCameraUsageDescription": "Чтобы сфотографировать удостоверение личности",
        "NSPhotoLibraryUsageDescription": "Чтобы выбрать фото удостоверения",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "kz.tdkfood.partner",
      "adaptiveIcon": {
        "backgroundColor": "#1F4D2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы показывать заказы рядом и передавать клиенту, где находится курьер",
          "locationAlwaysAndWhenInUsePermission": "Чтобы клиент видел курьера на карте, даже когда приложение свёрнуто",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Чтобы сфотографировать удостоверение личности"
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8f00089f-cf49-48c3-a50a-1b1e40e4fbc7"
      }
    },
    "owner": "bekarystm"
  }
}
